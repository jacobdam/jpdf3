{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(python3:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(xcodebuild:*)",
      "Bash(xcrun:*)",
      "Bash(swift:*)",
      "Bash(mutool:*)",
      "Bash(qpdf:*)",
      "Bash(pdftoppm:*)",
      "Bash(pdftotext:*)",
      "Bash(pdfsig:*)",
      "Bash(rustup:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(wc:*)",
      "Bash(mkdir:*)",
      "Bash(diff:*)",
      "Bash(jq:*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(ops/driver/codex-review.sh:*)",
      "Bash(./ops/driver/codex-review.sh:*)"
    ],
    "deny": [
      "Bash(gh auth token:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(security find-generic-password:*)",
      "Bash(security find-internet-password:*)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.codex/**)",
      "Bash(codex:*)",
      "Read(./ops/judge/corpus/exam.tsv)",
      "mcp__claude_ai_Gmail",
      "mcp__claude_ai_Google_Calendar",
      "mcp__claude_ai_Google_Drive",
      "mcp__claude_ai_TickTick",
      "mcp__claude_ai_Claude_Docs",
      "mcp__claude-design",
      "mcp__cmux-cua"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "G=\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"; [ -f \"$G\" ] || exit 0; exec python3 -I \"$G\""
          }
        ]
      }
    ]
  }
}
