{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo:*)", "Bash(git:*)", "Bash(gh:*)", "Bash(python3:*)", "Bash(npm:*)", "Bash(npx:*)",
      "Bash(node:*)", "Bash(xcodebuild:*)", "Bash(xcrun:*)", "Bash(swift:*)", "Bash(mutool:*)",
      "Bash(qpdf:*)", "Bash(pdftoppm:*)", "Bash(pdftotext:*)", "Bash(pdfsig:*)", "Bash(rustup:*)",
      "Bash(ls:*)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(grep:*)", "Bash(find:*)",
      "Bash(sed:*)", "Bash(awk:*)", "Bash(wc:*)", "Bash(mkdir:*)", "Bash(diff:*)", "Bash(jq:*)",
      "Read", "Edit", "Write", "Glob", "Grep"
    ],
    "deny": [
      "Bash(gh auth token:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(security find-generic-password:*)",
      "Bash(security find-internet-password:*)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(./ops/judge/corpus/exam.tsv)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "G=\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"; [ -f \"$G\" ] || exit 0; exec python3 -I \"$G\""
          }
        ]
      }
    ]
  }
}
