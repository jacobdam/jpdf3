+_SINGLE_GH_POST = re.compile(r"gh (issue|pr) (comment|create|edit) [A-Za-z0-9 _./:#=@,+'-]*")
+
+
+def inert_view(cmd, texts):
+    """The whitespace-collapsed command with its inert gh titles/bodies removed, but only if what
+    remains is one plain gh post: no shell metacharacters (; & | < > $ ` \\ " newline), so no
+    second command can run a stripped copy of the text (bash -c, eval). Otherwise the full text."""
+    stripped = " ".join(strip_inert_text(cmd, texts).split())
+    return stripped if _SINGLE_GH_POST.fullmatch(stripped) else " ".join(cmd.split())
+
