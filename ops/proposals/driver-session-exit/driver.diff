@@ -62,23 +64,98 @@ slow_mode() {  # judge broken > 7 days: 1 session/day (AUTOMATION.md §6.2)
   (( $(date +%s) - since > 7*86400 ))
 }
 
+# Prints "<last> <bg>" for a stream-json session log: <last> is the type of the last turn event
+# (assistant, user or result; "none" before the first) and <bg> the length of the last
+# background_tasks_changed list (running background agents and shells). Non-JSON lines are skipped.
+session_state() {
+  jq -Rr 'fromjson? | objects
+    | if .type == "system" and .subtype == "background_tasks_changed" then "bg \(.tasks | length)"
+      elif .type == "assistant" or .type == "user" or .type == "result" then .type
+      else empty end' "$1" 2>/dev/null |
+    awk '$1 == "bg" { bg = $2; next } { last = $1 }
+         END { print (last == "" ? "none" : last), (bg == "" ? 0 : bg) }'
+}
+
+# Exit status from the session's last result line (0, or 1 if is_error); empty if there is none.
+result_rc() {
+  jq -Rr 'fromjson? | objects | select(.type == "result") | if .is_error == true then 1 else 0 end' \
+    "$1" 2>/dev/null | tail -n 1
+}
+
+# A real usage limit: the last result line is an error that names a limit (or carries HTTP 429),
+# or the CLI's last rate_limit_event is "rejected"; with no result line at all, the CLI's stderr
+# names one. Never grep the whole transcript: every log has rate_limit_event lines (status
+# "allowed"), and tool output can quote any of these words.
+LIMIT_RE='usage limit|rate.?limit|limit reached|hit your limit|resets at|out of (extra )?usage'
+usage_limited() {
+  local out=$1 err=$2 v
+  v=$(jq -Rrn --arg re "$LIMIT_RE" '[inputs | fromjson? | objects] as $e
+    | ([$e[] | select(.type == "result")] | last) as $r
+    | ([$e[] | select(.type == "rate_limit_event")] | last) as $l
+    | if ($l.rate_limit_info.status // "") == "rejected" then "yes"
+      elif $r == null then "none"
+      elif $r.is_error == true and ($r.api_error_status == 429
+             or (($r.result // "") | tostring | test($re; "i"))) then "yes"
+      else "no" end' "$out" 2>/dev/null)
+  case "$v" in
+    yes) return 0 ;;
+    none) grep -qiE "$LIMIT_RE" "$err" 2>/dev/null ;;
+    *) return 1 ;;
+  esac
+}
+
+# TERM the session's process group (claude, its MCP servers, shells and agents), KILL what is
+# left after 15 s.
+stop_group() {
+  local pid=$1 _
+  kill -TERM -- "-$pid" 2>/dev/null
+  for _ in {1..15}; do kill -0 -- "-$pid" 2>/dev/null || return 0; sleep 1; done
+  kill -KILL -- "-$pid" 2>/dev/null
+}
+
 run_session() {
-  local ts out start rc sid
-  ts=$(date -u +%Y%m%dT%H%M%SZ); out="ops/logs/$ts.jsonl"; start=$(date +%s)
+  local ts out err start rc res sid pid now idle why=""
+  ts=$(date -u +%Y%m%dT%H%M%SZ); out="ops/logs/$ts.jsonl"; err="ops/logs/$ts.stderr"; start=$(date +%s)
   log "session $ts starting"
   # Agent sessions get only the project MCP config (an isolated headless Chrome), never the
   # owner's claude.ai connectors (mail, drive, calendar) or the owner's own browser.
-  JPDF_SESSION=1 ENABLE_CLAUDEAI_MCP_SERVERS=false claude -p "$(cat ops/TICK.md)" \
+  # perl puts the session in its own process group (pgid = pid), so stop_group reaches
+  # everything it spawned; stderr goes to its own file so usage_limited can read it alone.
+  JPDF_SESSION=1 ENABLE_CLAUDEAI_MCP_SERVERS=false \
+    perl -e 'setpgrp(0, 0); exec { $ARGV[0] } @ARGV or die "exec $ARGV[0]: $!\n"' -- \
+      claude -p "$(cat ops/TICK.md)" \
       --strict-mcp-config --mcp-config ops/driver/mcp.json \
-      --permission-mode auto --output-format stream-json --verbose > "$out" 2>&1 &
-  local pid=$!
-  ( sleep "$SESSION_MAX"; kill -TERM "$pid" 2>/dev/null ) & local watchdog=$!
+      --permission-mode auto --output-format stream-json --verbose > "$out" 2> "$err" &
+  pid=$!
+  # A finished `claude -p` can stay alive (a pending ScheduleWakeup, a stuck child; #125). Stop it
+  # once its last turn event is a result, no background task is running, and the log has been
+  # quiet for SETTLE_GRACE seconds. A background task's notification restarts the turn and the
+  # log, so waits on agents or shells are not cut short; SESSION_MAX still caps those.
+  while kill -0 "$pid" 2>/dev/null; do
+    sleep "$POLL"
+    now=$(date +%s)
+    if (( now - start >= SESSION_MAX )); then
+      why="SESSION_MAX"; log "session $ts reached SESSION_MAX (${SESSION_MAX}s): stopping"
+      stop_group "$pid"; break
+    fi
+    [[ "$(session_state "$out")" == "result 0" ]] || continue
+    idle=$(( now - $(stat -f %m "$out") ))
+    if (( idle >= SETTLE_GRACE )); then
+      why="settled"; log "session $ts idle ${idle}s after its final result, no background tasks: stopping"
+      stop_group "$pid"; break
+    fi
+  done
   wait "$pid"; rc=$?
-  kill "$watchdog" 2>/dev/null; wait "$watchdog" 2>/dev/null
+  # Killed by a signal (ours or the owner's) after it had finished: report what the session
+  # itself reported in its final result, not the signal.
+  if (( rc > 128 )) && [[ "$(session_state "$out")" == "result 0" ]]; then
+    res=$(result_rc "$out"); rc=${res:-$rc}
+  fi
+  [[ -s "$err" ]] || rm -f "$err"
   sid=$(grep -m1 -o '"session_id":"[^"]*"' "$out" | cut -d'"' -f4)
   printf '%s\t%s\t%s\t%ss\n' "$ts" "$rc" "${sid:-?}" "$(( $(date +%s) - start ))" >> ops/logs/index.tsv
-  log "session $ts finished rc=$rc session=${sid:-?} (resume: claude --resume ${sid:-?})"
-  if grep -qiE 'usage limit|rate.?limit|limit reached|resets at|out of (extra )?usage' "$out" && (( rc != 0 )); then
+  log "session $ts finished rc=$rc${why:+ stopped=$why} session=${sid:-?} (resume: claude --resume ${sid:-?})"
+  if (( rc != 0 )) && usage_limited "$out" "$err"; then
     return 42
   fi
   return "$rc"
